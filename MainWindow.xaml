<Window x:Class="SensVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SensVault"
        mc:Ignorable="d"
        Title="SensVault" Height="640" Width="1180"
        Background="{StaticResource Base}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="13">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- left: input panel -->
        <Border Grid.Column="0" Background="{StaticResource Mantle}" Padding="16,14">
            <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">

                <!-- add a profile -->
                <TabItem Header="Profile">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel x:Name="DraftPanel">
                            <TextBlock Text="PROFILE NAME" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="GAME" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="GameBox" IsSynchronizedWithCurrentItem="False"
                                      IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                      MaxDropDownHeight="380"
                                      SelectionChanged="GameBox_SelectionChanged"/>

                            <TextBlock Text="DPI" Style="{StaticResource Label}"/>
                            <TextBox x:Name="DpiBox" Text="800" TextChanged="DpiBox_TextChanged"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="IN-GAME SENS" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="SensBox" Text="1" TextChanged="SensBox_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="CM/360" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="CmBox" TextChanged="CmBox_TextChanged"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Foreground="{StaticResource Overlay0}" FontSize="11" Margin="0,5,0,0"
                                       TextWrapping="Wrap"
                                       Text="Type either one; the other follows."/>

                            <TextBlock Text="NOTES" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" Height="52" TextWrapping="Wrap"/>

                            <Border Background="{StaticResource Surface0}" CornerRadius="6"
                                    Padding="12,9" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource Subtext}" FontSize="12"
                                               Text="{Binding In360, StringFormat={}{0:F2} in/360}"/>
                                    <TextBlock Foreground="{StaticResource Overlay0}" FontSize="11" Margin="0,3,0,0"
                                               Text="{Binding Edpi, StringFormat=eDPI {0:F0}}"/>
                                </StackPanel>
                            </Border>

                            <Button Content="Save profile" Click="AddProfile_Click" Margin="0,14,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- convert between games -->
                <TabItem Header="Convert">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource Subtext}" TextWrapping="Wrap" FontSize="11"
                                       Text="Match a saved profile's cm/360 in another game."/>

                            <TextBlock Text="FROM PROFILE" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="FromBox" DisplayMemberPath="Name"
                                      IsSynchronizedWithCurrentItem="False"
                                      SelectionChanged="Convert_Changed"/>

                            <TextBlock Text="TO GAME" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="ToBox" IsSynchronizedWithCurrentItem="False"
                                      IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                      MaxDropDownHeight="380"
                                      SelectionChanged="Convert_Changed"/>

                            <TextBlock Text="TARGET DPI" Style="{StaticResource Label}"/>
                            <TextBox x:Name="ToDpi" Text="800" TextChanged="Convert_Changed"/>

                            <Border Background="{StaticResource Surface0}" CornerRadius="6"
                                    Padding="12,10" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="SET IN-GAME SENS TO" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="ConvResult" Foreground="{StaticResource Text}"
                                               FontSize="26" FontWeight="Bold" Text="--"/>
                                    <TextBlock x:Name="ConvDetail" Foreground="{StaticResource Subtext}"
                                               FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Button Content="Save as profile" Click="SaveConverted_Click" Margin="0,14,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- game library -->
                <TabItem Header="Games">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource Subtext}" TextWrapping="Wrap" FontSize="11"
                                       Text="Game missing? Enter a known cm/360 at any sens/DPI and the yaw constant is derived for you."/>

                            <TextBlock Text="GAME NAME" Style="{StaticResource Label}"/>
                            <TextBox x:Name="NgName"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="AT SENS" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="NgSens" Text="1"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="AT DPI" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="NgDpi" Text="800"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="KNOWN CM/360" Style="{StaticResource Label}"/>
                            <TextBox x:Name="NgCm"/>

                            <Button Content="Add game" Click="AddGame_Click" Margin="0,14,0,0"/>

                            <TextBlock Text="LIBRARY" Style="{StaticResource Label}" Margin="0,20,0,3"/>
                            <ListBox x:Name="GameList" Height="180" IsSynchronizedWithCurrentItem="False"
                                     Background="{StaticResource Surface0}"
                                     BorderBrush="{StaticResource Surface1}" Foreground="{StaticResource Text}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Width="180" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Yaw}" Foreground="{StaticResource Overlay0}" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="Remove selected custom game" Style="{StaticResource Ghost}"
                                    Click="RemoveGame_Click" Margin="0,8,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- right: the vault -->
        <Grid Grid.Column="1" Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" x:Name="FilterBox" IsSynchronizedWithCurrentItem="False"
                          MaxDropDownHeight="380" SelectionChanged="Filter_Changed"/>
                <TextBox Grid.Column="1" x:Name="Search" Margin="8,0,0,0"
                         TextChanged="Search_TextChanged"
                         ToolTip="Filter by name, game or notes"/>
                <Button Grid.Column="2" Content="Delete" Style="{StaticResource Ghost}"
                        Click="Delete_Click" Margin="8,0,0,0"/>
            </Grid>

            <DataGrid Grid.Row="1" x:Name="Grid_"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="{StaticResource Base}" BorderThickness="0"
                      HorizontalGridLinesBrush="{StaticResource Surface0}"
                      RowHeight="34" SelectionMode="Extended"
                      AllowDrop="True"
                      PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                      MouseMove="Grid_MouseMove"
                      Drop="Grid_Drop"
                      PreviewKeyDown="Grid_PreviewKeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.4*"/>
                    <DataGridTextColumn Header="GAME" Binding="{Binding Game}" Width="1.5*"/>
                    <DataGridTextColumn Header="CM/360" Binding="{Binding Cm360, StringFormat={}{0:F1}}"
                                        IsReadOnly="True" Width="0.7*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="IN/360" Binding="{Binding In360, StringFormat={}{0:F2}}"
                                        IsReadOnly="True" Width="0.7*"/>
                    <DataGridTextColumn Header="DPI" Binding="{Binding Dpi}" Width="0.6*"/>
                    <DataGridTextColumn Header="SENS" Binding="{Binding Sens, StringFormat={}{0:G6}}" Width="0.7*"/>
                    <DataGridTextColumn Header="EDPI" Binding="{Binding Edpi, StringFormat={}{0:F0}}"
                                        IsReadOnly="True" Width="0.6*"/>
                    <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="1.2*"/>
                    <DataGridTextColumn Header="ADDED" Binding="{Binding Added, StringFormat={}{0:yyyy-MM-dd}}"
                                        IsReadOnly="True" Width="0.8*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" x:Name="Status" Foreground="{StaticResource Overlay0}"
                       FontSize="11" Margin="2,10,0,0"/>
        </Grid>
    </Grid>
</Window>
