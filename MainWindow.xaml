<Window x:Class="SensVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SensVault"
        mc:Ignorable="d"
        Title="SensVault" Height="640" Width="1180"
        MinWidth="990" MinHeight="420"
        Background="{StaticResource Base}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="13"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Window.Resources>
        <!-- Rise-and-fade toast. One storyboard, restarted on each copy, so rapid clicks
             re-arm the timer instead of stacking up. -->
        <Storyboard x:Key="ToastPop">
            <DoubleAnimation Storyboard.TargetName="Toast" Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.14"/>
            <DoubleAnimation Storyboard.TargetName="ToastShift" Storyboard.TargetProperty="Y"
                             From="10" To="0" Duration="0:0:0.24">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Toast" Storyboard.TargetProperty="Opacity"
                             To="0" BeginTime="0:0:1.25" Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="ToastShift" Storyboard.TargetProperty="Y"
                             To="8" BeginTime="0:0:1.25" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="Trimmed" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- left: input panel -->
        <Border Grid.Column="0" Background="{StaticResource Mantle}" Padding="16,14">
            <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">

                <!-- add a profile -->
                <TabItem Header="Profile">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel x:Name="DraftPanel">
                            <TextBlock Text="Name" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Game" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="GameBox" IsSynchronizedWithCurrentItem="False"
                                      IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                      MaxDropDownHeight="380"
                                      SelectionChanged="GameBox_SelectionChanged"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Sensitivity" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="SensBox" Text="1" TextChanged="SensBox_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="DPI" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="DpiBox" Text="800" TextChanged="DpiBox_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- Sits between the two ways in, centred, so the either/or reads
                                 off the layout instead of needing a sentence to explain it. -->
                            <TextBlock Text="or" HorizontalAlignment="Center" Margin="0,9,0,0"
                                       Foreground="{StaticResource Overlay0}" FontSize="11"/>

                            <TextBlock Text="Cm/360" Style="{StaticResource Label}" Margin="0,4,0,3"/>
                            <TextBox x:Name="CmBox" TextChanged="CmBox_TextChanged"/>

                            <Button Content="Save" Click="AddProfile_Click" Margin="0,18,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- convert between games -->
                <TabItem Header="Convert">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource Subtext}" TextWrapping="Wrap" FontSize="11"
                                       Text="Match a saved profile's cm/360 in another game."/>

                            <TextBlock Text="From Profile" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="FromBox" DisplayMemberPath="Name"
                                      IsSynchronizedWithCurrentItem="False"
                                      MaxDropDownHeight="380"
                                      SelectionChanged="Convert_Changed"/>

                            <TextBlock Text="To Game" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="ToBox" IsSynchronizedWithCurrentItem="False"
                                      IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                      MaxDropDownHeight="380"
                                      SelectionChanged="Convert_Changed"/>

                            <TextBlock Text="Target DPI" Style="{StaticResource Label}"/>
                            <TextBox x:Name="ToDpi" Text="800" TextChanged="Convert_Changed"/>

                            <Border Background="{StaticResource Surface0}" CornerRadius="6"
                                    Padding="12,10" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Set Sensitivity To" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="ConvResult" Foreground="{StaticResource Text}"
                                               FontSize="26" FontWeight="Bold" Text="--"/>
                                    <TextBlock x:Name="ConvDetail" Foreground="{StaticResource Subtext}"
                                               FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Button Content="Save" Click="SaveConverted_Click" Margin="0,14,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- right: the vault -->
        <Grid Grid.Column="1" Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" x:Name="FilterBox" IsSynchronizedWithCurrentItem="False"
                          MaxDropDownHeight="380" SelectionChanged="Filter_Changed"/>
                <TextBox Grid.Column="1" x:Name="Search" Margin="8,0,0,0"
                         TextChanged="Search_TextChanged"
                         ToolTip="Filter by name or game"/>
            </Grid>

            <!-- MinWidth per column is the resize floor: enough for the header plus a few
                 characters, so a column can never be dragged down to nothing. Past that
                 the grid scrolls horizontally rather than crushing the columns.

                 Only the two text columns are star-sized. If the fixed ones were stars too
                 they would fall under their MinWidth on a narrow window and clamp back up.
                 WPF does not reclaim that space from the wide columns, so the total
                 overflows and a horizontal scrollbar appears well above the size floor. -->
            <DataGrid Grid.Row="1" x:Name="Grid_"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="{StaticResource Base}" BorderThickness="0"
                      HorizontalGridLinesBrush="{StaticResource Surface0}"
                      HorizontalScrollBarVisibility="Auto"
                      RowHeight="34" SelectionMode="Extended"
                      AllowDrop="True"
                      PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                      MouseMove="Grid_MouseMove"
                      Drop="Grid_Drop"
                      PreviewKeyDown="Grid_PreviewKeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}"
                                        Width="*" MinWidth="110"
                                        ElementStyle="{StaticResource Trimmed}"
                                        EditingElementStyle="{StaticResource CellEditor}"/>
                    <!-- A template column rather than a text one: a game is not free text,
                         it carries the yaw constant every number in the row depends on. -->
                    <DataGridTemplateColumn Header="GAME" Width="*" MinWidth="110"
                                            SortMemberPath="Game">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Game}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource CellCombo}"
                                          ItemsSource="{Binding Games,
                                                       RelativeSource={RelativeSource AncestorType=Window}}"
                                          IsEditable="True" IsTextSearchEnabled="True"
                                          StaysOpenOnEdit="True" MaxDropDownHeight="380"
                                          IsSynchronizedWithCurrentItem="False"
                                          Loaded="GameCell_Loaded"
                                          SelectionChanged="GameCell_SelectionChanged"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="SensColumn" Header="SENS"
                                        Binding="{Binding Sens, StringFormat={}{0:G6}}"
                                        Width="92" MinWidth="76"
                                        EditingElementStyle="{StaticResource CellEditor}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="ToolTip" Value="Click to copy"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="DPI" Binding="{Binding Dpi}"
                                        Width="80" MinWidth="64"
                                        EditingElementStyle="{StaticResource CellEditor}"/>
                    <DataGridTextColumn Header="CM/360" Binding="{Binding Cm360, StringFormat={}{0:F1}}"
                                        IsReadOnly="True" Width="96" MinWidth="82">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ADDED" Binding="{Binding Added, StringFormat={}{0:MMM d yyyy}}"
                                        IsReadOnly="True" Width="108" MinWidth="96">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Overlay0}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1" x:Name="Toast" Opacity="0" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                    Background="{StaticResource Surface1}" CornerRadius="16" Padding="16,8">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastShift" Y="10"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.55" Color="#000000"/>
                </Border.Effect>
                <TextBlock x:Name="ToastText" Foreground="{StaticResource Text}" FontSize="12"/>
            </Border>

            <TextBlock Grid.Row="2" x:Name="Status" Foreground="{StaticResource Overlay0}"
                       FontSize="11" Margin="2,10,0,0"/>
        </Grid>
    </Grid>
</Window>
