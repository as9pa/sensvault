<UserControl x:Class="SensVault.DpiPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="Segoe UI" FontSize="13">

    <UserControl.Resources>
        <!-- One row of the drop-down. Deliberately not BasedOn the app Button style: this
             is a menu line, not a command button, so it wants the ComboBoxItem look. -->
        <Style x:Key="PresetRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="3"
                                Margin="3,1" Padding="9,6">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background"
                                        Value="{StaticResource Surface1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="Frame" Background="{StaticResource Surface0}"
                BorderBrush="{StaticResource Surface1}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>

                <!-- Borderless inside the frame: the frame above is the visible input, so
                     the box must not draw a second one inside it.

                     A hand, not an I-beam: a single click here cycles presets, so the box
                     advertises itself as a button. It only turns into a caret cursor once
                     a double click has actually put you in typing mode. -->
                <TextBox x:Name="Box" Grid.Column="0"
                         Background="Transparent" BorderThickness="0" Padding="7,4"
                         VerticalContentAlignment="Center"
                         PreviewMouseLeftButtonDown="Box_PreviewMouseLeftButtonDown"
                         TextChanged="Box_TextChanged">
                    <TextBox.Style>
                        <!-- Cursor lives in the style, not as an attribute on the element: a
                             local value outranks a style trigger, so setting it inline would
                             pin it to Hand and the IBeam swap below would never fire. -->
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="Cursor" Value="IBeam"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Not x:Name="Drop": that generates a field which shadows UIElement.Drop. -->
                <ToggleButton x:Name="DropArrow" Grid.Column="1" Focusable="False" Cursor="Hand"
                              IsChecked="{Binding IsOpen, ElementName=Menu, Mode=TwoWay}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <!-- Transparent fill, not none: an unpainted Grid is not hit-testable
                                 and the arrow alone would be a 7px target. -->
                            <Grid Background="Transparent">
                                <Border Width="1" HorizontalAlignment="Left" Margin="0,5"
                                        Background="{StaticResource Surface1}"/>
                                <Path x:Name="Arrow" Data="{StaticResource CaretDown}"
                                      Fill="{StaticResource Overlay0}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="1,0,0,0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Arrow" Property="Fill"
                                            Value="{StaticResource Text}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Arrow" Property="Fill"
                                            Value="{StaticResource Text}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>
        </Border>

        <Popup x:Name="Menu" PlacementTarget="{Binding ElementName=Frame}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="None"
               Opened="Menu_Opened">
            <!-- The margin is shadow room; AllowsTransparency lets it fall outside the card.
                 The shadow is cast by a sibling behind the card rather than by the card, so
                 the menu text is not inside an Effect subtree; that is what was rasterising
                 it and making it look pixelated. Ideal formatting for the same reason: a
                 layered window cannot do ClearType, and Display's pixel snapping on top of
                 grayscale antialiasing is what looked chewed up. -->
            <Grid Margin="0,2,8,10">
                <Border Background="{StaticResource Surface0}" CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
                    </Border.Effect>
                </Border>
                <Border x:Name="Card" Background="{StaticResource Surface0}"
                        BorderBrush="{StaticResource Surface1}" BorderThickness="1"
                        CornerRadius="4" TextOptions.TextFormattingMode="Ideal">
                <StackPanel Margin="0,3,0,0">
                    <ItemsControl x:Name="PresetList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PresetRow}"
                                        Content="{Binding Text}" Click="Preset_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Full-bleed rule, then the add row: the line is what separates
                         "pick one" from "change the list". -->
                    <Border Height="1" Background="{StaticResource Surface1}" Margin="0,3,0,0"/>
                    <Button Style="{StaticResource PresetRow}"
                            HorizontalContentAlignment="Center" Click="Manage_Click"
                            ToolTip="Edit presets">
                        <Path Data="{StaticResource PlusIcon}" Stroke="{StaticResource Subtext}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
