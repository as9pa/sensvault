<Application x:Class="SensVault.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SensVault"
             xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- The palette. These values are Vault Dark, the default, and they are what the
             designer renders — but at runtime ThemeManager.Apply replaces every one of them.

             Which is why each of these keys is referenced as a DynamicResource throughout,
             and the styles and geometry below are not: a StaticResource keeps the object it
             resolved to at parse time, so it would go on painting the theme the app started
             in. See ThemeManager for why swapping is the only route and mutating in place is
             not available. -->
        <SolidColorBrush x:Key="Base"     Color="#141414"/>
        <SolidColorBrush x:Key="Mantle"   Color="#0F0F0F"/>
        <SolidColorBrush x:Key="Crust"    Color="#080808"/>
        <SolidColorBrush x:Key="Surface0" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Surface1" Color="#2E2E2E"/>
        <!-- One step above Surface1, reserved for the commit button on each tab: light
             enough to read as the one thing you press, dark enough not to shout. -->
        <SolidColorBrush x:Key="Surface2" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="Surface3" Color="#4A4A4A"/>
        <SolidColorBrush x:Key="Overlay0" Color="#707070"/>
        <SolidColorBrush x:Key="Subtext"  Color="#9C9C9C"/>
        <SolidColorBrush x:Key="Text"     Color="#E8E8E8"/>
        <SolidColorBrush x:Key="Accent"   Color="#E8E8E8"/>
        <SolidColorBrush x:Key="Red"      Color="#E07070"/>
        <!-- Ink that cannot be derived from Text. TextStrong is the emphasis above it, and
             ButtonText is the label on Surface2 — which is a dark chip in most themes but the
             dialog's own face colour in the Classic pair, where white would vanish. -->
        <SolidColorBrush x:Key="TextStrong" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ButtonText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Selection"  Color="#8A8A8A"/>
        <!-- The two edges of a 1px chisel, drawn only by the Classic themes. Both collapse to
             nothing elsewhere, because BevelTL and BevelBR below go to zero thickness. -->
        <SolidColorBrush x:Key="BevelLight" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BevelDark"  Color="#808080"/>

        <!-- Shape. Every CornerRadius in the app comes from one of these five, so the Classic
             themes can square the whole window at once. -->
        <CornerRadius x:Key="RadSm">3</CornerRadius>
        <CornerRadius x:Key="RadMd">4</CornerRadius>
        <CornerRadius x:Key="RadLg">5</CornerRadius>
        <CornerRadius x:Key="RadCard">6</CornerRadius>
        <CornerRadius x:Key="RadPill">16</CornerRadius>

        <!-- Type. Five sizes and no others, so a heading cannot end up one point off the
             heading beside it. Static rather than dynamic: a theme may not resize the app. -->
        <sys:Double x:Key="FontCaption">11</sys:Double>
        <sys:Double x:Key="FontSecondary">12</sys:Double>
        <sys:Double x:Key="FontBody">13</sys:Double>
        <sys:Double x:Key="FontTitle">15</sys:Double>
        <sys:Double x:Key="FontDisplay">24</sys:Double>

        <!-- How long a hover or a press takes to arrive. App.OnStartup drops this to zero
             when Windows has been told not to animate. -->
        <Duration x:Key="MotionDuration">0:0:0.12</Duration>

        <!-- Focus, as a focus visual rather than as a trigger. WPF draws one of these only
             while the keyboard is driving and skips it for a click, which is the distinction
             an IsKeyboardFocused trigger cannot make: a button takes focus when you press it,
             so a trigger leaves a ring on everything you have clicked lately. It also lands in
             the adorner layer, above the control and outside its layout.

             A Border rather than the usual Rectangle, because RadiusX and RadiusY are plain
             doubles and cannot take RadMd: a Rectangle would ring a rounded button with a
             square, and would keep its corners under the Classic themes, which square
             everything else. -->
        <Style x:Key="AccentFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadMd}"
                                Margin="-1" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The same ring for a control whose own face is the accent, where the accent ring
             would land on itself and disappear. -->
        <Style x:Key="StrongFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border BorderBrush="{DynamicResource TextStrong}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadMd}"
                                Margin="-1" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top-left and bottom-right of the bevel, as two layers: a Border paints all four
             edges with one brush, so a raised or sunken frame cannot be done in a single one.
             Raised puts BevelLight on TL, sunken swaps them. -->
        <Thickness x:Key="BevelTL">0</Thickness>
        <Thickness x:Key="BevelBR">0</Thickness>

        <!-- The flat hairline round a field or a framed toggle. It goes to zero exactly when
             the bevel comes on, so a Classic control wears one edge rather than two stacked. -->
        <Thickness x:Key="EdgeT">1</Thickness>

        <!-- Icon geometry, drawn rather than taken from a symbol font: Segoe Fluent Icons
             is not guaranteed present, and a missing glyph fails as a blank box.
             The gear is on a 24x24 canvas; the rest are sized to their own use. -->
        <Geometry x:Key="GearIcon">M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z</Geometry>
        <Geometry x:Key="SliderRails">M0,3.5 H16 M0,8 H16 M0,12.5 H16</Geometry>
        <Geometry x:Key="GripIcon">M0,0.5 H10 M0,4.5 H10 M0,8.5 H10</Geometry>
        <Geometry x:Key="CrossIcon">M0,0 L8,8 M8,0 L0,8</Geometry>
        <Geometry x:Key="PlusIcon">M5.5,0 V11 M0,5.5 H11</Geometry>
        <Geometry x:Key="CaretDown">M0,0 L7,0 L3.5,4.5 Z</Geometry>
        <Geometry x:Key="ChevronsLeft">M4.5,0 L0.5,4.5 L4.5,9 M9.5,0 L5.5,4.5 L9.5,9</Geometry>
        <!-- Two arrows passing each other, for the two boxes that write to one another. -->
        <Geometry x:Key="SyncIcon">M5,2 V14 M5,2 L2.5,4.5 M5,2 L7.5,4.5 M11,14 V2 M11,14 L13.5,11.5 M11,14 L8.5,11.5</Geometry>
        <!-- One arrow, for the divider on the Convert panel: a conversion runs one way,
             from the profile above it into the game below. -->
        <Geometry x:Key="ArrowDownIcon">M8,2 V14 M8,14 L4,10 M8,14 L12,10</Geometry>
        <!-- Two sheets, the front one over the back, for the cells that copy on a click. -->
        <Geometry x:Key="CopyIcon">M6,6 H13 V13 H6 Z M3,10 V3 H10</Geometry>
        <Geometry x:Key="SearchIcon">M7,2.5 a4.5,4.5 0 1 0 0,9 a4.5,4.5 0 0 0 0,-9 Z M10.3,10.3 L14,14</Geometry>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Subtext}"/>
            <Setter Property="FontSize" Value="{StaticResource FontCaption}"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Surface0}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
            <!-- Selection used to be Surface1 (#2E2E2E) on a #1E1E1E box: a two-step
                 difference that read as "the text got slightly darker" rather than as a
                 highlight. #8A8A8A at 45% composites to about #4E4E4E, which is a clear
                 jump while staying inside the palette's no-colour-cast rule.

                 Deliberately not the Windows accent: this machine's is #393939, so matching
                 the system would land right back on invisible.

                 Every text box in the app inherits from here (the one inside the ComboBox
                 template and the grid's cell editor included), so this one setter covers
                 selection everywhere. -->
            <Setter Property="SelectionBrush" Value="{DynamicResource Selection}"/>
            <Setter Property="SelectionOpacity" Value="0.45"/>
            <Setter Property="SelectionTextBrush" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Surface1}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource EdgeT}"/>
            <Setter Property="Padding" Value="6,4"/>
            <!-- The stock focus visual is a dotted rectangle drawn outside the control, which
                 on a rounded box sits off the corners. The accent edge below replaces it. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadMd}">
                            <!-- Sunken: the shadow falls at the top-left, which is what tells
                                 a Classic field apart from a Classic button. Zero thickness in
                                 every other theme, so these two layers cost nothing there. -->
                            <Border BorderBrush="{DynamicResource BevelDark}"
                                    BorderThickness="{DynamicResource BevelTL}">
                                <Border BorderBrush="{DynamicResource BevelLight}"
                                        BorderThickness="{DynamicResource BevelBR}">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- A box you cannot type in should not look like one you can.
                     Everything moves one step the other way: a live box sits *above* its
                     panel at Surface0 on Mantle, so a dead one sinks below it to Crust and
                     reads as a recess rather than a field. The border loses its contrast and
                     the text drops from Text to Overlay0, which is the same grey the app
                     already uses for "here, but not for you".

                     On the style rather than at each call site, so every read-only box in the
                     app gets it: the locked sensitivity box on the Create panel and the
                     data-folder path in settings both come through here. A Foreground set
                     inline still wins, since a local value outranks a style trigger. -->
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Crust}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Overlay0}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Surface0}"/>
                    <!-- Nothing is going in, so nothing should blink as though it might. -->
                    <Setter Property="CaretBrush" Value="Transparent"/>
                </Trigger>
                <!-- Last, so it wins over the read-only edge: a box you can tab into and
                     select from still has to say when the keyboard is in it.
                     IsKeyboardFocusWithin rather than IsFocused, because the box that holds
                     the caret in a templated control is a child of the one being styled. -->
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </Trigger>
                <!-- After the focus edge, so it outranks it. A field the app has just
                     refused has to stay refused while you are standing in it fixing it;
                     going accent the moment the caret lands would take the complaint away
                     at exactly the wrong time. MainWindow clears it on the next keystroke. -->
                <Trigger Property="local:FieldState.IsInvalid" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Red}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A DataGridTextColumn hands its editor DefaultEditingElementStyle, which outranks
             the implicit TextBox style above and leaves a white box on the dark grid. Every
             editable column has to point at this explicitly. -->
        <Style x:Key="CellEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource Surface1}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Overlay0}"/>
            <!-- A 34px row leaves the editor very little once the cell's own padding is
                 taken out. Any margin here, plus generous padding, squeezes the content
                 host below one line height and clips the glyphs through the middle.

                 The negative margin claims back most of the cell's editing padding so the
                 box is not cramped, and Padding then puts the text back where it rests.
                 Padding counts twice here: TextBoxBase copies it onto the content host
                 that the template already margins by Padding. So the resting 8px is
                 (5 cell - 2 margin) + 1 border + 2x1 padding + WPF's 2px caret gutter. -->
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Margin" Value="-2,0,-2,0"/>
            <Setter Property="Padding" Value="1,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- A field that says what it filters. Everything except the template comes from
             the default text box above, triggers included: the accent edge on focus and the
             red one on a refusal still land, because this template binds BorderBrush the
             same way the default one does.

             The prompt is a TextBlock in the template rather than text put in the box. Text
             in the box is text the filter would then go looking for, and clearing it would
             be the user's job. It reads Chrome.Placeholder off the control, so a second
             search field is a style reference and one attached property rather than a
             second copy of this template. -->
        <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadMd}">
                            <Border BorderBrush="{DynamicResource BevelDark}"
                                    BorderThickness="{DynamicResource BevelTL}">
                                <Border BorderBrush="{DynamicResource BevelLight}"
                                        BorderThickness="{DynamicResource BevelBR}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource SearchIcon}"
                                              Width="13" Height="13" Stretch="Uniform"
                                              Stroke="{DynamicResource Overlay0}" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Margin="8,0,0,0"
                                              VerticalAlignment="Center"/>
                                        <!-- Prompt and caret share one cell and one inset, so
                                             the first character lands exactly where the prompt
                                             started. Trimmed rather than clipped: this box is
                                             star-sized and can be squeezed narrower than the
                                             sentence, which would otherwise be painted straight
                                             out over the button beside it. -->
                                        <Grid Grid.Column="1">
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                          Margin="{TemplateBinding Padding}"/>
                                            <TextBlock x:Name="Prompt" Visibility="Collapsed"
                                                       Text="{TemplateBinding local:Chrome.Placeholder}"
                                                       Foreground="{DynamicResource Overlay0}"
                                                       IsHitTestVisible="False"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="{TemplateBinding Padding}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Prompt" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- scrollbar: default WPF chrome is light and looks wrong on dark -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="t" Background="{DynamicResource Surface1}"
                                                        CornerRadius="{DynamicResource RadLg}" Margin="2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <!-- One step up to say it is grabbable, a
                                                         second to say it is grabbed: dragging
                                                         is the one time the pointer has left
                                                         the thumb and the fill is all there is
                                                         to confirm it. -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="t" Property="Background"
                                                                Value="{DynamicResource Surface2}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="t" Property="Background"
                                                                Value="{DynamicResource Surface3}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Width" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- full ComboBox retemplate; the stock one renders a white box on dark themes -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource Surface0}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Surface1}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource EdgeT}"/>
            <Setter Property="Padding" Value="8,5"/>
            <!-- Same reason as the text box: the accent edge is the focus ring here. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <!-- Two columns on purpose. The editable text box lives in column 0
                             only, so it cannot swallow clicks meant for the arrow; the
                             toggle spans both and picks up whatever the text box misses. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Bd" Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource RadMd}">
                                <!-- Sunken, to match the text box it sits beside. -->
                                <Border BorderBrush="{DynamicResource BevelDark}"
                                        BorderThickness="{DynamicResource BevelTL}">
                                    <Border BorderBrush="{DynamicResource BevelLight}"
                                            BorderThickness="{DynamicResource BevelBR}"/>
                                </Border>
                            </Border>
                            <ToggleButton Grid.ColumnSpan="2"
                                          Focusable="False" ClickMode="Press" Background="Transparent"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path x:Name="Arrow"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" Data="M0,0 L7,0 L3.5,4.5 Z"
                                                  Fill="{DynamicResource Overlay0}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Fill"
                                                        Value="{DynamicResource Text}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Fill"
                                                        Value="{DynamicResource Text}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- All four bindings are load-bearing. DisplayMemberPath is not
                                 implemented as an ItemTemplate: ItemsControl installs an
                                 internal template *selector* and leaves ItemTemplate null, so
                                 a template that binds only SelectionBoxItemTemplate hands the
                                 presenter no template at all and it falls back to ToString() —
                                 which is how this box came to read "SensVault.SensProfile". -->
                            <ContentPresenter x:Name="ContentSite" Grid.Column="0" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Visibility="Hidden"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     Foreground="{DynamicResource Text}"
                                     Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="PART_Popup" Grid.ColumnSpan="2"
                                   AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   PopupAnimation="None">
                                <!-- The shadow is cast by a sibling behind the card, never by
                                     the card itself. An Effect forces its whole subtree through
                                     an intermediate bitmap, and text rendered that way loses
                                     ClearType and comes out looking chewed up next to the rest
                                     of the app. Ideal formatting on top: a popup is a layered
                                     window, so it cannot have ClearType anyway, and Display's
                                     whole-pixel snapping is what turns that into "pixelated". -->
                                <Grid Margin="0,2,0,6">
                                    <Border Background="{DynamicResource Surface0}" CornerRadius="{DynamicResource RadMd}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                                              Opacity="0.5" Color="#000000"/>
                                        </Border.Effect>
                                    </Border>
                                    <Border Background="{DynamicResource Surface0}"
                                            BorderBrush="{DynamicResource Surface1}"
                                            BorderThickness="1" CornerRadius="{DynamicResource RadMd}"
                                            TextOptions.TextFormattingMode="Ideal"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ScrollViewer Margin="0,3">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Overlay0}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Overlay0}"/>
                            </Trigger>
                            <!-- Last of the three, so the keyboard's own signal outranks the
                                 grey the mouse and the open list leave behind. -->
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <!-- Last again, for the reason the text box's copy gives. It has
                                 to live in here rather than in Style.Triggers: the three
                                 above set Bd's brush directly, which outranks the template
                                 binding a Style setter would be writing through. -->
                            <Trigger Property="local:FieldState.IsInvalid" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Red}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same size and alignment goal as CellEditor. The combo's inner text box has no
             padding of its own, so here Padding counts once rather than twice: the text
             lands on (5 cell - 2 margin) + 3 padding + 2. -->
        <Style x:Key="CellCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{DynamicResource Surface1}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Overlay0}"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Margin" Value="-2,0,-2,0"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="{DynamicResource RadSm}" Margin="3,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface1}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="{DynamicResource RadSm}" Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface1}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- White text on Surface2 lands at 11.4:1 contrast, comfortably past WCAG's 7:1
             AAA bar, so the label stays legible while the button itself stays quiet. -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ButtonText}"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <!-- Brighten, don't dim. Fading a dark button toward a dark panel reads as "going
                 away"; only a light button can dim on hover and still look pressed. Press then
                 goes the other way, one step below the resting face, because a button that
                 brightens further under the finger has nowhere left to go. -->
            <Setter Property="local:Chrome.HoverBrush" Value="{DynamicResource Surface3}"/>
            <Setter Property="local:Chrome.PressedBrush" Value="{DynamicResource Surface1}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadLg}">
                            <Grid>
                                <!-- Hover and press are washes over the face rather than a new
                                     Background on it, because a wash can fade: the palette
                                     brushes are shared and frozen, so animating a colour is
                                     out and animating an element's opacity is what is left.
                                     The host carries Chrome.HoverOpacity so the animation
                                     inside it can stay a plain 0 to 1. -->
                                <Border IsHitTestVisible="False"
                                        Opacity="{TemplateBinding local:Chrome.HoverOpacity}">
                                    <Border x:Name="hover" Opacity="0"
                                            CornerRadius="{DynamicResource RadLg}"
                                            Background="{TemplateBinding local:Chrome.HoverBrush}"/>
                                </Border>
                                <Border x:Name="press" Visibility="Collapsed" IsHitTestVisible="False"
                                        CornerRadius="{DynamicResource RadLg}"
                                        Opacity="{TemplateBinding local:Chrome.PressedOpacity}"
                                        Background="{TemplateBinding local:Chrome.PressedBrush}"/>
                                <!-- Raised, the mirror of the field: light to the top-left. -->
                                <Border BorderBrush="{DynamicResource BevelLight}"
                                        BorderThickness="{DynamicResource BevelTL}">
                                    <Border BorderBrush="{DynamicResource BevelDark}"
                                            BorderThickness="{DynamicResource BevelBR}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover"
                                                             Storyboard.TargetProperty="Opacity" To="1"
                                                             Duration="{StaticResource MotionDuration}">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover"
                                                             Storyboard.TargetProperty="Opacity" To="0"
                                                             Duration="{StaticResource MotionDuration}">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- No fade on the way down. A press is an answer to something the
                                 hand just did and has to land with it. -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="press" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The one button on a panel that commits what the panel is for. There is at most
             one per tab, which is what earns it the accent: a second would leave neither of
             them reading as the answer.

             Setters only, on the attached properties the template above binds to, so this
             shares that template instead of forking a second copy of it. The washes cannot
             be steps on the grey ramp here, because the face is a colour rather than a step:
             a thin TextStrong sheen lifts it and a thin Crust one presses it whatever the
             theme has made the accent, and both stay quiet enough not to lose the label.

             AccentText is the one key not declared above: no palette carries it, because a
             label on the accent has to read on a lavender and on a yellow alike. ThemeManager
             works it out per theme, as whichever of Crust, TextStrong and ButtonText stands
             furthest from that theme's accent. -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
            <Setter Property="local:Chrome.HoverBrush" Value="{DynamicResource TextStrong}"/>
            <Setter Property="local:Chrome.HoverOpacity" Value="0.10"/>
            <Setter Property="local:Chrome.PressedBrush" Value="{DynamicResource Crust}"/>
            <Setter Property="local:Chrome.PressedOpacity" Value="0.16"/>
            <!-- An accent ring drawn on an accent face is not there at all. -->
            <Setter Property="FocusVisualStyle" Value="{StaticResource StrongFocusVisual}"/>
        </Style>

        <!-- A square, chromeless button for glyph-only affordances: the column picker's
             sliders, a row's delete cross, the "add a preset" plus. -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Overlay0}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <!-- A glyph button starts from nothing, so its washes are the two quietest steps
                 on the ramp rather than the two the commit button uses. -->
            <Setter Property="local:Chrome.HoverBrush" Value="{DynamicResource Surface1}"/>
            <Setter Property="local:Chrome.PressedBrush" Value="{DynamicResource Surface2}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadMd}">
                            <Grid>
                                <Border IsHitTestVisible="False"
                                        Opacity="{TemplateBinding local:Chrome.HoverOpacity}">
                                    <Border x:Name="hover" Opacity="0"
                                            CornerRadius="{DynamicResource RadMd}"
                                            Background="{TemplateBinding local:Chrome.HoverBrush}"/>
                                </Border>
                                <Border x:Name="press" Visibility="Collapsed" IsHitTestVisible="False"
                                        CornerRadius="{DynamicResource RadMd}"
                                        Opacity="{TemplateBinding local:Chrome.PressedOpacity}"
                                        Background="{TemplateBinding local:Chrome.PressedBrush}"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover"
                                                             Storyboard.TargetProperty="Opacity" To="1"
                                                             Duration="{StaticResource MotionDuration}">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover"
                                                             Storyboard.TargetProperty="Opacity" To="0"
                                                             Duration="{StaticResource MotionDuration}">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="press" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Framed toggle for the column picker: reads as an input, not a command. -->
        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Overlay0}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <!-- Unchecked, the wash is the face's own colour and the hover reads off the
                 border and the glyph instead: Surface1 is what checked looks like, and
                 hovering an empty toggle should not make it look ticked. Checked swaps the
                 wash for a step above itself, in the trigger below. -->
            <Setter Property="local:Chrome.HoverBrush" Value="{DynamicResource Surface0}"/>
            <Setter Property="local:Chrome.PressedBrush" Value="{DynamicResource Surface2}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{DynamicResource Surface0}"
                                BorderBrush="{DynamicResource Surface1}"
                                BorderThickness="{DynamicResource EdgeT}"
                                CornerRadius="{DynamicResource RadMd}">
                            <Grid>
                                <Border IsHitTestVisible="False"
                                        Opacity="{TemplateBinding local:Chrome.HoverOpacity}">
                                    <Border x:Name="hover" Opacity="0"
                                            CornerRadius="{DynamicResource RadMd}"
                                            Background="{TemplateBinding local:Chrome.HoverBrush}"/>
                                </Border>
                                <Border x:Name="press" Visibility="Collapsed" IsHitTestVisible="False"
                                        CornerRadius="{DynamicResource RadMd}"
                                        Opacity="{TemplateBinding local:Chrome.PressedOpacity}"
                                        Background="{TemplateBinding local:Chrome.PressedBrush}"/>
                                <Border BorderBrush="{DynamicResource BevelLight}"
                                        BorderThickness="{DynamicResource BevelTL}">
                                    <Border BorderBrush="{DynamicResource BevelDark}"
                                            BorderThickness="{DynamicResource BevelBR}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush"
                                        Value="{DynamicResource Overlay0}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover"
                                                             Storyboard.TargetProperty="Opacity" To="1"
                                                             Duration="{StaticResource MotionDuration}">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover"
                                                             Storyboard.TargetProperty="Opacity" To="0"
                                                             Duration="{StaticResource MotionDuration}">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="press" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background"
                                        Value="{DynamicResource Surface1}"/>
                                <Setter TargetName="b" Property="BorderBrush"
                                        Value="{DynamicResource Overlay0}"/>
                                <Setter TargetName="hover" Property="Background"
                                        Value="{DynamicResource Surface2}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The stock checkbox paints a light box with black text and looks broken here. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <!-- Transparent fill across the whole row, so the label and the gap
                             beside it are as clickable as the 15px box. -->
                        <Border Background="Transparent" Padding="7,5" CornerRadius="{DynamicResource RadSm}">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="box" Width="15" Height="15"
                                        CornerRadius="{DynamicResource RadSm}"
                                        Background="{DynamicResource Surface0}"
                                        BorderBrush="{DynamicResource Overlay0}"
                                        BorderThickness="{DynamicResource EdgeT}"
                                        VerticalAlignment="Center">
                                    <!-- Sunken, like the fields: a Classic tick box is a well. -->
                                    <Border BorderBrush="{DynamicResource BevelDark}"
                                            BorderThickness="{DynamicResource BevelTL}">
                                        <Border BorderBrush="{DynamicResource BevelLight}"
                                                BorderThickness="{DynamicResource BevelBR}">
                                            <Path x:Name="tick" Visibility="Collapsed"
                                                  Data="M0,3.2 L2.6,5.8 L7,0.8"
                                                  Stroke="{DynamicResource Text}" StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                    </Border>
                                </Border>
                                <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background"
                                        Value="{DynamicResource Surface1}"/>
                                <Setter TargetName="box" Property="BorderBrush"
                                        Value="{DynamicResource Subtext}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush"
                                        Value="{DynamicResource Text}"/>
                            </Trigger>
                            <!-- The last visible column disables its own box rather than
                                 vanishing, so it stays obvious *why* it will not turn off. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The stock TabControl template hardcodes <TabPanel IsItemsHost="True"/>, so
             overriding ItemsPanel alone does nothing. A DockPanel host is what lets the
             settings tab sit at the far right of the same strip as the text tabs. -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Column 1 hosts whatever is in Tag: a place for a plain button
                                 on the tab strip. It cannot go in the items host, because
                                 only TabItems may live there and a button is an action, not
                                 a tab. Sitting in its own column puts it just right of the
                                 last right-docked tab rather than on top of it. -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DockPanel Grid.Column="0" IsItemsHost="True" LastChildFill="False"
                                           KeyboardNavigation.TabIndex="1"/>
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Tag}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"
                                              KeyboardNavigation.TabIndex="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Overlay0}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b" Background="Transparent" Padding="14,8" Margin="0,0,4,0"
                                CornerRadius="{DynamicResource RadLg}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface0}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <!-- Halfway to selected, and only on the tabs you can still go to.
                                 The selected tab already sits at Text and has nowhere to
                                 brighten to. -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource Subtext}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The invisible grab strip either side of a header that resizes the column.
             A retemplated header has to re-declare both by name or the DataGrid
             silently loses column resizing. -->
        <Style x:Key="HeaderGripper" TargetType="Thumb">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="prim:DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Mantle}"/>
            <Setter Property="Foreground" Value="{DynamicResource Subtext}"/>
            <Setter Property="FontSize" Value="{StaticResource FontCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Surface0}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="prim:DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center"/>
                                    <!-- One arrow per sort state, stacked in the same slot: the
                                         column claims no width while both are collapsed, so an
                                         unsorted header keeps its full text room. -->
                                    <Path x:Name="Ascending" Grid.Column="1" Visibility="Collapsed"
                                          Data="M0,4.5 L3.5,0 L7,4.5 Z" Fill="{DynamicResource Text}"
                                          Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <Path x:Name="Descending" Grid.Column="1" Visibility="Collapsed"
                                          Data="M0,0 L7,0 L3.5,4.5 Z" Fill="{DynamicResource Text}"
                                          Margin="0,0,8,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                                   Style="{StaticResource HeaderGripper}"/>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                   Style="{StaticResource HeaderGripper}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- The sorted column is also the one whose label brightens, so the
                                 arrow is a confirmation rather than the only signal. -->
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="Ascending" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="Descending" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base at rest and two steps up from it: pointing at a row lifts it to Surface0,
             selecting it to Surface1. Both used to sit a step lower, which put hover on
             Mantle, the panel colour from under the grid, so the row you were pointing at
             read as a dent rather than as the one you were about to act on. The
             MultiTrigger is what stops a selected row you happen to be over from dropping
             back down to the hover colour.

             The focus inset is a Border laid over the row, not a border on it. DataGrid's
             RowHeight is the height of the cells presenter, not of the row: a real border
             adds its two pixels on top of the 34 and every row after the first moves down,
             which cost the last row on screen its place at the default window size. An
             overlay takes no layout at all, so the pitch stays exactly 34 and the
             horizontal gridline stays where WPF draws it, at the bottom of the cell.

             Transparent until the keyboard arrives, and never painted for the mouse. Not a
             FocusVisualStyle either: WPF draws that for the element that holds focus, and
             the mark has to stay on the row while the focus is down inside one of its
             cells. Everything else in the template is the stock DataGridRow one, kept whole
             so row headers and details behave as they always did. -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource Base}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="Row" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <prim:SelectiveScrollingGrid>
                                <prim:SelectiveScrollingGrid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </prim:SelectiveScrollingGrid.ColumnDefinitions>
                                <prim:SelectiveScrollingGrid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </prim:SelectiveScrollingGrid.RowDefinitions>
                                <prim:DataGridCellsPresenter Grid.Column="1"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                <prim:DataGridDetailsPresenter
                                    Grid.Column="1" Grid.Row="1"
                                    Visibility="{TemplateBinding DetailsVisibility}"
                                    prim:SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding
                                        AreRowDetailsFrozen,
                                        RelativeSource={RelativeSource AncestorType=DataGrid},
                                        Converter={x:Static DataGrid.RowDetailsScrollingConverter},
                                        ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}}"/>
                                <prim:DataGridRowHeader
                                    Grid.RowSpan="2"
                                    prim:SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                    Visibility="{Binding
                                        HeadersVisibility,
                                        RelativeSource={RelativeSource AncestorType=DataGrid},
                                        Converter={x:Static DataGrid.HeadersVisibilityConverter},
                                        ConverterParameter={x:Static DataGridHeadersVisibility.Row}}"/>
                                <!-- Last, so it is drawn over the cells rather than under
                                     them, and hit-test free so it cannot take a click that
                                     belongs to the row. -->
                                <Border x:Name="Focus" Grid.RowSpan="2" Grid.ColumnSpan="2"
                                        BorderBrush="Transparent" BorderThickness="1"
                                        IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                            </prim:SelectiveScrollingGrid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Not while a cell of it is open: the editor wears the accent
                                 on its own edge, and an accent rectangle inside an accent
                                 rectangle is one too many. -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                                    <Condition Property="IsEditing" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Focus" Property="BorderBrush"
                                        Value="{DynamicResource Accent}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface1}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface0}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Surface1}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <!-- WPF's stock focus visual is a dotted rectangle, and it only appears once
                 a key has been pressed — Esc cancelling a drag is enough to summon one
                 mid-grid. The row highlight already says which row is current. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Reading padding is too tight to hold an input box. Hand the editor most
                     of the row back; the text column keeps its resting inset. -->
                <Trigger Property="IsEditing" Value="True">
                    <Setter Property="Padding" Value="5,2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The cells you can click to copy, with the glyph that says so. It shows only
             while the row is under the pointer: on every row it would be two columns of
             clutter down the whole grid, and on none of them the feature stays what it has
             been until now, which is invisible.

             In the cell rather than in a template column, so the two columns keep the
             machinery they already have: the G6 format, the sort, and in the sens column an
             editor that opens on a double click. A DataGridTemplateColumn would have to be
             handed all three again, and its editing template would need its own focus.

             The glyph takes its width from the row rather than overlapping the number: a
             hint painted over the value it is offering to copy is the one thing it must not
             do. -->
        <Style x:Key="CopyCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                <Path x:Name="Hint" Grid.Column="1" Visibility="Collapsed"
                                      Data="{StaticResource CopyIcon}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{DynamicResource Overlay0}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Margin="8,0,0,0"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Value="True"
                                         Binding="{Binding IsMouseOver,
                                                   RelativeSource={RelativeSource AncestorType=DataGridRow}}">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <!-- After the hover trigger, so it wins: a cell open for editing
                                 gives the editor the whole width back. -->
                            <Trigger Property="IsEditing" Value="True">
                                <Setter TargetName="Hint" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tooltips. The stock one is a pale yellow Win32 rectangle with a square border,
             which is the last piece of system chrome the app had left. Every existing
             ToolTip="..." picks this up, since a bare string is wrapped in a ToolTip and the
             implicit style finds it. -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontSize" Value="{StaticResource FontCaption}"/>
            <!-- The system shadow ignores the corner radius and leaves square corners
                 hanging off the card, the same way it did on the context menu. -->
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource Surface1}"
                                BorderBrush="{DynamicResource Surface2}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadMd}"
                                Padding="8,4">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right-click menus. Stock WPF menus are drawn in the system light theme and
             would arrive as a white card over a dark grid, so the whole thing is retemplated
             to the same card the column picker uses: Surface0 on a Surface1 hairline. -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource Surface0}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Surface1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="3,5"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <!-- The stock shadow is a system-drawn one that ignores the border radius and
                 leaves square corners hanging off a rounded card. -->
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadMd}" Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="{DynamicResource RadSm}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- IsHighlighted, not IsMouseOver: it is the one the keyboard
                                 moves as well, so arrowing through lights the same row. -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background"
                                        Value="{DynamicResource Surface1}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Overlay0}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Keyed to the menu's own separator key rather than TargetType, so this reaches
             separators inside menus and leaves any others alone. -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource Surface1}"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
